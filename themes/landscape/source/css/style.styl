@import "_variables"

// Reset ---------------------------------------------------------------------

*, *::before, *::after
  box-sizing: border-box

html, body, h1, h2, h3, h4, h5, h6, p, figure, blockquote, dl, dd, ol, ul, pre
  margin: 0
  padding: 0

ol, ul
  list-style: none

img, svg, video
  max-width: 100%
  height: auto
  display: block

button, input, textarea
  font: inherit
  color: inherit
  margin: 0

// Base ----------------------------------------------------------------------

html
  scroll-behavior: smooth
  // Headings sit clear of the sticky header when jumped to from the contents.
  scroll-padding-top: 96px

body
  background: color-paper
  color: color-body
  font-family: font-sans
  font-size: 17px
  line-height: line-height
  -webkit-font-smoothing: antialiased
  -webkit-text-size-adjust: 100%
  text-rendering: optimizeLegibility

a
  color: inherit
  text-decoration: none
  transition: color 150ms ease, opacity 150ms ease, border-color 150ms ease

::selection
  background: color-accent-rule
  color: color-ink

:focus-visible
  outline: 2px solid color-accent
  outline-offset: 3px

#container
  display: flex
  flex-direction: column
  min-height: 100vh

#main
  flex: 1 0 auto

.page
  max-width: site-width
  margin: 0 auto
  padding: 0 gutter-width

// Shared pieces -------------------------------------------------------------

.eyebrow
  font-family: font-mono
  font-size: 11px
  letter-spacing: 0.14em
  text-transform: uppercase
  color: color-faint

.lede
  font-family: font-display
  font-size: 24px
  line-height: 1.45
  color: color-muted
  max-width: 46ch
  text-wrap: pretty

.dot
  width: 3px
  height: 3px
  border-radius: 50%
  background: #cec7b8
  display: inline-block
  flex: none

.underlined
  font-family: font-mono
  font-size: 11.5px
  color: color-accent
  border-bottom: 1px solid color-accent-rule
  padding-bottom: 2px
  align-self: start
  &:hover
    border-bottom-color: color-accent

.link-row
  display: flex
  flex-wrap: wrap
  gap: 22px
  font-family: font-mono
  font-size: 12.5px
  color: color-accent
  padding-top: 4px
  a
    border-bottom: 1px solid color-accent-rule
    padding-bottom: 3px
    &:hover
      border-bottom-color: color-accent

.link-column
  display: flex
  flex-direction: column
  align-items: flex-start
  gap: 9px
  font-family: font-mono
  font-size: 12px
  color: color-accent
  a
    border-bottom: 1px solid color-accent-rule
    padding-bottom: 3px
    &:hover
      border-bottom-color: color-accent

// The hatched stand-in used wherever an image has not been supplied.
hatch()
  background-color: color-panel
  background-image: repeating-linear-gradient(135deg, color-panel-hatch 0 9px, color-panel 9px 18px)

// Pagination ----------------------------------------------------------------

#page-nav
  display: flex
  justify-content: center
  gap: 10px
  flex-wrap: wrap
  font-family: font-mono
  font-size: 12.5px
  padding: 12px 0 72px
  border-top: 1px solid color-rule
  margin-top: 8px
  padding-top: 32px
  a, span
    padding: 6px 11px
    border-radius: 4px
    color: color-muted-2
  a:hover
    color: color-accent
  .current
    color: color-ink
    background: color-panel
  .space
    color: color-faintest

@import "_partial/header"
@import "_partial/footer"
@import "_partial/home"
@import "_partial/article"
@import "_partial/prose"
@import "_partial/highlight"
@import "_partial/index"
@import "_partial/about"
@import "_partial/responsive"
