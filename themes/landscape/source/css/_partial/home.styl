// Home: display hero on the left, the latest post pulled out on a rule to the
// right, then the writing list.

.home-hero
  display: grid
  grid-template-columns: 1.4fr 1fr
  gap: 72px
  align-items: end
  padding: 76px 0 52px
  border-bottom: 1px solid color-rule

.home-hero-lead
  display: flex
  flex-direction: column
  gap: 24px

  h1
    font-family: font-display
    font-size: 52px
    line-height: line-height-title
    letter-spacing: -0.025em
    font-weight: 500
    color: color-ink
    max-width: 24ch
    text-wrap: balance

  .lede
    font-family: font-sans
    font-size: 18px
    line-height: 1.65
    color: #4f4a41
    max-width: 54ch

.home-hero-latest
  border-left: 2px solid color-ink
  padding: 4px 0 4px 24px
  display: flex
  flex-direction: column
  gap: 10px

  .meta
    font-family: font-mono
    font-size: 11.5px
    color: color-faint

.home-hero-latest-title
  font-family: font-display
  font-size: 25px
  line-height: 1.22
  letter-spacing: -0.015em
  color: color-ink

  &:hover
    color: color-accent

.post-list-section
  padding: 40px 0 24px

  > .eyebrow
    display: block
    padding-bottom: 8px

.post-list
  display: flex
  flex-direction: column

.post-list-item
  display: grid
  grid-template-columns: 1fr 132px
  gap: 40px
  align-items: baseline
  padding: 26px 0
  border-top: 1px solid color-rule

  &:hover
    opacity: 0.62

.post-list-body
  display: flex
  flex-direction: column
  gap: 9px

.post-list-title
  font-family: font-display
  font-size: 27px
  line-height: 1.2
  letter-spacing: -0.02em
  font-weight: 500
  color: color-ink
  text-wrap: pretty

.post-list-excerpt
  font-size: 16px
  line-height: 1.62
  color: color-muted
  max-width: 62ch
  text-wrap: pretty

.post-list-meta
  display: flex
  flex-direction: column
  align-items: flex-end
  font-family: font-mono
  font-size: 11.5px
  color: color-faint
  text-align: right
  line-height: 1.7
