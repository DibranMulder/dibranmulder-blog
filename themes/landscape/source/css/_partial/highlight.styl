// Code is the one dark surface in the design. Hexo emits
// figure.highlight > table > tr > td.gutter + td.code, with unprefixed
// highlight.js token classes (hljs: false in _config.yml).

.prose

  figure.highlight, pre
    border: 1px solid color-code-border
    border-radius: 8px
    background: color-code-bg
    overflow: hidden
    color: color-code-text

  pre
    font-family: font-mono
    font-size: 13px
    line-height: 1.8
    padding: 18px
    overflow-x: auto

  code
    // Inside a dark block the inline chip styling has to be undone.
    pre &, figure.highlight &
      background: none
      border: 0
      padding: 0
      font-size: inherit

  figure.highlight
    font-family: font-mono
    font-size: 13px
    line-height: 1.8

    // Filename/language bar, injected by script.js.
    .code-head
      display: flex
      align-items: center
      justify-content: space-between
      gap: 16px
      padding: 10px 15px
      border-bottom: 1px solid color-code-rule
      font-size: 11px
      color: color-code-meta

    .code-lang
      letter-spacing: 0.08em

    .code-copy
      background: none
      border: 0
      padding: 0
      font-family: font-mono
      font-size: 11px
      color: color-code-key
      cursor: pointer

      &:hover
        color: #fff

    table
      width: 100%
      border-collapse: collapse
      display: block

    tr, tbody
      display: block

    tr
      display: flex

    td
      border: 0
      padding: 0
      vertical-align: top

    pre
      border: 0
      border-radius: 0
      background: none
      margin: 0
      padding: 18px 0

    .gutter
      flex: none
      user-select: none

      pre
        padding-left: 18px
        padding-right: 14px
        text-align: right
        color: #4d5a6b

    // Only the code column scrolls, so the line numbers stay put.
    .code
      flex: 1 1 auto
      min-width: 0
      overflow-x: auto

      pre
        padding-right: 18px

    .line
      display: inline-block
      min-width: 100%

  // Tokens
  .comment, .quote
    color: color-code-comment
    font-style: italic

  .keyword, .selector-tag, .literal, .meta-keyword, .doctag
    color: #c79ae0

  .attr, .attribute, .property, .variable, .template-variable
    color: color-code-key

  .string, .regexp, .addition, .meta-string
    color: color-code-string

  .number, .symbol, .bullet
    color: color-code-number

  .title, .name, .function, .class, .section, .selector-id
    color: #8fb8e8

  .params
    color: color-code-text

  .tag
    color: #8fb8e8

  .tag .name
    color: #c79ae0

  .punctuation, .operator
    color: color-code-meta

  .meta
    color: color-code-meta

  .deletion
    color: #e08c8c

  .emphasis
    font-style: italic

  .strong
    font-weight: 600
