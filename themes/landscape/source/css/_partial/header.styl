// Sticky wordmark bar with a mono nav, plus the reading progress rule that
// only appears on post pages.

#header
  position: sticky
  top: 0
  z-index: 20
  background: color-paper
  border-bottom: 1px solid color-rule

.header-inner
  max-width: site-width
  margin: 0 auto
  padding: 20px gutter-width
  display: flex
  align-items: center
  justify-content: space-between
  gap: 24px

.wordmark
  font-family: font-display
  font-size: 19px
  font-weight: 600
  letter-spacing: -0.02em
  color: color-ink
  white-space: nowrap

.site-nav
  display: flex
  align-items: center
  gap: 28px
  font-family: font-mono
  font-size: 12px
  letter-spacing: 0.06em
  text-transform: uppercase
  color: color-muted-2

  a:hover
    color: color-ink

  .is-current
    color: color-ink

#reading-progress
  position: fixed
  top: 0
  left: 0
  right: 0
  height: 2px
  z-index: 30
  pointer-events: none

  span
    display: block
    height: 100%
    width: 0
    background: color-accent
