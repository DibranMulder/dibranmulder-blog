// Reading view: centred hero, then a three-column grid of
// contents rail | article | author rail.

.page-post
  padding-bottom: 24px

.post-hero
  padding: 72px 0 44px
  display: flex
  justify-content: center
  border-bottom: 1px solid color-rule

.post-hero-inner
  max-width: 74ch
  width: 100%
  display: flex
  flex-direction: column
  gap: 22px

  h1
    font-family: font-display
    font-size: 54px
    line-height: line-height-title
    letter-spacing: -0.03em
    font-weight: 500
    color: color-ink
    max-width: 26ch
    text-wrap: balance

.post-kicker
  display: flex
  align-items: center
  gap: 14px
  flex-wrap: wrap
  font-family: font-mono
  font-size: 11.5px
  letter-spacing: 0.14em
  text-transform: uppercase
  color: color-faint

.post-kicker-topic
  color: color-accent

  &:hover
    color: color-ink

.reading-grid
  display: grid
  grid-template-columns: toc-width minmax(0, measure) rail-width
  gap: grid-gap
  justify-content: center
  padding: 52px 0 72px

.reading-main
  min-width: 0

// Contents rail -------------------------------------------------------------

.reading-rail
  align-self: start
  position: sticky
  top: 96px

.reading-rail-toc
  display: flex
  flex-direction: column
  gap: 11px
  font-family: font-mono
  font-size: 12px

.toc
  display: flex
  flex-direction: column
  gap: 11px

  .eyebrow
    font-size: 10.5px
    color: color-faintest
    padding-bottom: 5px

.toc-link
  color: color-muted-2
  padding: 4px 0 4px 13px
  border-left: 1px solid color-rule-strong
  line-height: 1.5

  &:hover
    color: color-ink
    border-left-color: color-accent

  &.is-active
    color: color-ink
    border-left-color: color-accent

.toc-level-3
  padding-left: 24px
  font-size: 11.5px

.reading-rail-foot
  margin-top: 20px
  border-top: 1px solid color-rule
  padding-top: 16px
  display: flex
  flex-direction: column
  align-items: flex-start
  gap: 8px
  color: color-faint
  font-size: 11px
  line-height: 1.7

.share-link
  color: color-accent
  cursor: pointer

  &:hover
    color: color-ink

// Author rail ---------------------------------------------------------------

.reading-rail-author
  display: flex
  flex-direction: column
  gap: 14px
  border-left: 1px solid color-rule
  padding-left: 22px

  .eyebrow
    font-size: 10.5px
    color: color-faintest

.author-avatar
  width: 54px
  height: 54px
  border-radius: 50%
  border: 1px solid color-rule-strong
  object-fit: cover

.author-avatar-placeholder
  hatch()

.author-bio
  font-size: 15px
  line-height: 1.6
  color: color-muted
  text-wrap: pretty

  strong
    color: color-ink
    font-weight: 500

// Tags and post-to-post navigation ------------------------------------------

.tag-row
  display: flex
  gap: 8px
  flex-wrap: wrap
  padding-top: 14px
  border-top: 1px solid color-rule
  margin-top: 28px

  a
    font-family: font-mono
    font-size: 11.5px
    color: color-muted-2
    border: 1px solid color-rule-strong
    border-radius: 4px
    padding: 5px 10px

    &:hover
      border-color: color-accent
      color: color-accent

.post-nav
  display: grid
  grid-template-columns: 1fr 1fr
  gap: 20px
  border-top: 1px solid color-rule
  padding-top: 26px
  margin-top: 26px

.post-nav-link
  display: flex
  flex-direction: column
  gap: 8px

  &:hover
    opacity: 0.62

  .eyebrow
    letter-spacing: 0.1em
    font-size: 11px

.post-nav-next
  text-align: right
  align-items: flex-end

.post-nav-title
  font-family: font-display
  font-size: 21px
  line-height: 1.28
  letter-spacing: -0.015em
  color: color-ink
  text-wrap: pretty
