<%
var currentPath = '/' + (page.path || '');

// A menu entry is current when the page lives under it. "/" is the writing
// index, so posts count as current there too — but the archive, category and
// tag generators also set __index, hence the explicit exclusions.
function isCurrent(target){
  var base = String(target).replace(/index\.html$/, '').replace(/\/$/, '');
  if (!base) return is_post() || (is_home() && !is_archive() && !is_category() && !is_tag());
  return currentPath.indexOf(base) === 0;
}
%>
<header id="header">
  <div class="header-inner">
    <a class="wordmark" href="<%- url_for('/') %>"><%= theme.wordmark || config.author || config.title %></a>
    <nav class="site-nav" aria-label="Main">
      <% for (var label in theme.menu){ %>
        <a href="<%- url_for(theme.menu[label]) %>"<% if (isCurrent(theme.menu[label])){ %> class="is-current" aria-current="page"<% } %>><%= label %></a>
      <% } %>
      <% if (theme.rss){ %>
        <a href="<%- url_for(theme.rss) %>">RSS</a>
      <% } %>
    </nav>
  </div>
</header>
